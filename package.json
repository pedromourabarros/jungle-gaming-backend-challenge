{
  "name": "jungle-gaming-distributed-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor with PostgreSQL financial invariants and SQS recovery",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun scripts/migrate.ts up",
    "db:rollback": "bun scripts/migrate.ts down",
    "queues:init": "bun scripts/init-queues.ts",
    "test:unit": "bun test test/unit test/messaging/consumer.test.ts",
    "test:integration": "bun test --timeout 90000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test": "bun run typecheck && bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:load": "bun scripts/load.ts",
    "demo": "bun scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.927.0",
    "@mikro-orm/core": "6.5.9",
    "@mikro-orm/migrations": "6.5.9",
    "@mikro-orm/postgresql": "6.5.9",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "@types/express": "5.0.5",
    "typescript": "5.9.3"
  }
}
