# Local development only. Compose supplies its own service hostnames.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://jungle_app:jungle_app@127.0.0.1:5432/jungle
MIGRATION_DATABASE_URL=postgresql://jungle_owner:devpassword@127.0.0.1:5432/jungle
DATABASE_POOL_MAX=12
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=10000
SQS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_POLL_WAIT_SECONDS=10
SQS_REQUEST_TIMEOUT_MS=15000
MESSAGING_ENABLED=true
SQS_CONSUMER_ENABLED=true
OUTBOX_ENABLED=true
PENDING_REFERENCE_ENABLED=true
WORKER_POLL_INTERVAL_MS=250
OUTBOX_LEASE_MS=60000
SHUTDOWN_GRACE_MS=25000
REFERENCE_RETRY_BASE_MS=500
REFERENCE_RETRY_MAX_MS=30000
REFERENCE_MAX_ATTEMPTS=20
REFERENCE_TTL_MS=86400000
CURSOR_SECRET=development-only-change-this-shared-cursor-secret
